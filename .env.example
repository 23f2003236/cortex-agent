# Cortex Agent 3.1 — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file to Git!

# NVIDIA NIM API Key (Obtain free at https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-nvidia-nim-api-key-here

# Default Model Selection
MODEL_NAME=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
MAX_OUTPUT_TOKENS=32768

# JWT Authentication Secret Key (Generate a random 64-char hex string in production)
SECRET_KEY=cortex-agent-secure-token-secret-change-in-production
